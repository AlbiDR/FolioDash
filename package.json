{
  "name": "foliodash",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A private portfolio tracker for Mac and Android.",
  "scripts": {
    "dev": "vite --config config/vite.config.ts --host 127.0.0.1",
    "build": "vite build --config config/vite.config.ts",
    "verify": "npm run verify:repository && npm run verify:interactions && npm run verify:contributors && npm run verify:punctuation && npm run typecheck && npm run lint && npm test && npm run verify:pages && npm run build && npm run verify:pwa && npm run verify:apps-script",
    "verify:contributors": "node scripts/verify-contributors.ts",
    "verify:punctuation": "node scripts/verify-punctuation.ts",
    "verify:workflows": "node scripts/verify-workflows.ts",
    "typecheck": "tsc --project config/tsconfig.json && tsc --project config/tsconfig.web.json && tsc --project config/tsconfig.scripts.json && tsc --project config/tsconfig.worker.json",
    "lint": "eslint --flag unstable_native_nodejs_ts_config --config config/eslint.config.ts src tests scripts config",
    "test": "vitest run --config config/vitest.config.ts",
    "audit:dependencies": "npm audit --audit-level=moderate",
    "build:apps-script": "node scripts/build-apps-script.ts",
    "verify:pwa": "node scripts/verify-pwa.ts",
    "verify:apps-script": "node scripts/verify-apps-script-bundle.ts",
    "preview": "vite preview --config config/vite.config.ts --host localhost --port 4173 --strictPort",
    "verify:repository": "node scripts/verify-repository.ts",
    "benchmark:history": "esbuild scripts/benchmark-history.ts --bundle --platform=node --format=esm --outfile=dist/benchmarks/history.mjs && node dist/benchmarks/history.mjs",
    "fixtures:onboarding": "esbuild scripts/generate-onboarding-fixtures.ts --bundle --platform=node --format=esm --outfile=dist/acceptance/generate-fixtures.mjs && node dist/acceptance/generate-fixtures.mjs",
    "build:acceptance": "vite build --config config/vite.acceptance.config.ts",
    "preview:acceptance": "vite preview --config config/vite.acceptance.config.ts",
    "capture:readme": "node scripts/capture-readme.ts",
    "prepare:pages": "node scripts/prepare-pages.ts",
    "verify:pages": "node --test scripts/prepare-pages.test.ts",
    "inventory:interactions": "node scripts/verify-interactions.ts --write",
    "verify:interactions": "node scripts/verify-interactions.ts",
    "audit:interactions": "node scripts/audit-interactions.ts"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "minimatch@^10.0.0": "11.0.1"
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "preact": "^11.1.1"
  }
}
