{
  "name": "foliodash",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A private portfolio tracker for Mac and Android.",
  "scripts": {
    "dev": "vite --config config/vite.config.ts --host 127.0.0.1",
    "build": "vite build --config config/vite.config.ts",
    "verify": "npm run verify:contributors && npm run typecheck && npm run lint && npm test && npm run build",
    "verify:contributors": "node scripts/verify-contributors.mjs",
    "typecheck": "tsc --project config/tsconfig.json && tsc --project config/tsconfig.web.json",
    "lint": "eslint --config config/eslint.config.js src tests",
    "test": "vitest run --config config/vitest.config.ts",
    "audit:dependencies": "npm audit --audit-level=high"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "preact": "^11.1.1"
  }
}
