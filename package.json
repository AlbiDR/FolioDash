{
  "name": "foliodash",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A private portfolio tracker for Mac and Android.",
  "scripts": {
    "dev": "vite --config config/vite.config.ts --host 127.0.0.1",
    "build": "vite build --config config/vite.config.ts",
    "verify": "npm run verify:repository && npm run verify:structure && npm run verify:docs && npm run verify:style && npm run format:check && npm run verify:interactions && npm run verify:contributors && npm run verify:punctuation && npm run typecheck && npm run lint && npm test && npm run verify:coverage && npm run test:scripts && npm run build && npm run verify:pwa && npm run verify:apps-script",
    "verify:contributors": "node scripts/verify/contributors.ts",
    "verify:punctuation": "node scripts/verify/punctuation.ts",
    "verify:workflows": "node scripts/verify/workflows.ts",
    "typecheck": "tsc --project config/tsconfig.json && tsc --project config/tsconfig.web.json && tsc --project config/tsconfig.scripts.json && tsc --project config/tsconfig.worker.json",
    "format": "prettier --config config/prettier.json --write \"src/**/*.{ts,tsx,css,json}\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"config/**/*.{ts,json}\" \"!src/interfaces/web/public/**\"",
    "format:check": "prettier --config config/prettier.json --check \"src/**/*.{ts,tsx,css,json}\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"config/**/*.{ts,json}\" \"!src/interfaces/web/public/**\"",
    "verify:oracle": "node scripts/verify/oracle.ts",
    "lint": "eslint --flag unstable_native_nodejs_ts_config --config config/eslint.config.ts src tests scripts config",
    "test": "vitest run --config config/vitest.config.ts --coverage",
    "test:scripts": "node --test \"scripts/**/*.test.ts\"",
    "verify:coverage": "node scripts/verify/coverage.ts",
    "audit:dependencies": "npm audit --omit=dev --audit-level=moderate",
    "build:apps-script": "node scripts/artifacts/apps-script.ts",
    "verify:pwa": "node scripts/verify/pwa.ts",
    "verify:apps-script": "node scripts/verify/apps-script-bundle.ts",
    "preview": "vite preview --config config/vite.config.ts --host localhost --port 4173 --strictPort",
    "verify:style": "node scripts/verify/style.ts",
    "verify:docs": "node scripts/verify/docs.ts",
    "docs:map": "node scripts/docs/repository-map.ts",
    "verify:structure": "node scripts/verify/structure.ts",
    "verify:repository": "node scripts/verify/repository.ts",
    "audit:history": "esbuild scripts/audit/benchmark-history.ts --bundle --platform=node --format=esm --outfile=dist/benchmarks/history.mjs && node dist/benchmarks/history.mjs",
    "build:fixtures": "esbuild scripts/artifacts/onboarding-fixtures.ts --bundle --platform=node --format=esm --outfile=dist/acceptance/generate-fixtures.mjs && node dist/acceptance/generate-fixtures.mjs",
    "build:acceptance": "vite build --config config/vite.acceptance.config.ts",
    "preview:acceptance": "vite preview --config config/vite.acceptance.config.ts",
    "capture:readme": "node scripts/docs/capture-readme.ts",
    "docs:readme": "node scripts/docs/render-readme-gallery.ts",
    "build:pages": "node scripts/artifacts/pages.ts",
    "docs:interactions": "node scripts/verify/interactions.ts --write",
    "verify:interactions": "node scripts/verify/interactions.ts",
    "audit:interactions": "node scripts/audit/interactions.ts",
    "audit:backfill-recovery": "node scripts/audit/backfill-recovery.ts",
    "audit:expense-recovery": "node scripts/audit/expense-recovery.ts",
    "audit:expense-restore": "node scripts/audit/expense-restore.ts",
    "audit:sale-closure": "node scripts/audit/sale-closure.ts",
    "audit:account-outcomes": "node scripts/audit/account-outcomes.ts",
    "audit:overview-signals": "node scripts/audit/overview-signals.ts",
    "audit:reduced-motion": "node scripts/audit/reduced-motion.ts",
    "audit:accessibility": "node scripts/audit/accessibility.ts",
    "audit:mutation": "stryker run config/stryker.config.json",
    "audit:checkpoints": "node scripts/audit/checkpoints.ts"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "axe-core": "4.14.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "minimatch@^10.0.0": "11.0.1"
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "preact": "^11.1.1"
  }
}
